rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Akun shared (satu login dipakai berdua) — tidak perlu rule cross-user,
    // cukup pastikan hanya user yang login yang bisa akses datanya sendiri
    // (Bagian 6.3 brief).
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
